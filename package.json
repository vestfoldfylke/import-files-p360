{
  "name": "import-files-p360",
  "description": "Script som håndterer import av filer til uregistrerte og strekkode import",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@biomejs/biome": "^2.5.6",
    "@navikt/fnrvalidator": "^1.3.0",
    "@vestfoldfylke/loglady": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "vtfk-schools-info": "^3.4.1"
  },
  "scripts": {
    "arkiver-kompetansebevis": "node ./lib/run-script.js ./scripts/archive-kompetansebevis.js",
    "arkiver-vitnemal": "node ./lib/run-script.js ./scripts/archive-vitnemal.js",
    "import-strekkode-til-p360": "node ./lib/run-script.js ./scripts/import-barcode-to-p360.js",
    "import-til-uregistrerte-p360": "node ./lib/run-script.js ./scripts/import-to-unregistered-p360.js",
    "manuell-test-get-ad-user": "node ./lib/run-script.js ./scripts/test-get-ad-user.js",
    "manuell-test-kompetansebevis": "node ./lib/run-script.js ./scripts/test-kompetansebevis.js",
    "manuell-test-logging": "node ./lib/run-script.js ./scripts/test-logging.js",
    "manuell-test-sannsynlige-titler": "node ./lib/run-script.js ./scripts/test-probable-titles.js",
    "manuell-test-vitnemal": "node ./lib/run-script.js ./scripts/test-vitnemal.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:verbose": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestfoldfylke/import-files-p360.git"
  },
  "author": "jorgtho",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vestfoldfylke/import-files-p360/issues"
  },
  "homepage": "https://github.com/vestfoldfylke/import-files-p360#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
