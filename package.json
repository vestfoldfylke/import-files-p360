{
  "name": "import-files-p360",
  "description": "Script som håndterer import av filer til uregistrerte og strekkode import",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "dependencies": {
    "@navikt/fnrvalidator": "^1.3.0",
    "@vestfoldfylke/msal-token": "^1.0.1",
    "@vestfoldfylke/pdf-text-extract": "^2.0.1",
    "@vtfk/logger": "^6.2.2",
    "axios": "^1.6.7",
    "csvtojson": "^2.0.10",
    "dotenv": "^16.3.1",
    "file-system-cache": "^2.4.4",
    "vtfk-schools-info": "^3.4.1"
  },
  "scripts": {
    "arkiver-kompetansebevis": "node ./lib/run-script.js ./scripts/archive-kompetansebevis.js",
    "arkiver-vitnemal": "node ./lib/run-script.js ./scripts/archive-vitnemal.js",
    "import-strekkode-til-p360": "node ./lib/run-script.js ./scripts/import-barcode-to-p360.js",
