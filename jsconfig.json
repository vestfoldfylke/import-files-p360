{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "lib/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",
    "config.js"
  ],
  "exclude": ["node_modules"]
}
